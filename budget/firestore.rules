rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function nonAnonymous() {
      return signedIn()
        && request.auth.token.firebase is map
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function verifiedEmail() {
      return nonAnonymous() && request.auth.token.email is string
        ? request.auth.token.email
        : '';
    }

    function validBudgetAccess(data) {
      return data.owner is string
        && data.ownerEmail is string
        && data.members is list;
    }

    function canReadBudget(data) {
      return nonAnonymous() && validBudgetAccess(data) && (
        data.owner == request.auth.uid ||
        verifiedEmail() in data.members
      );
    }

    function canListBudget(data) {
      return nonAnonymous() && (
        data.owner == request.auth.uid ||
        verifiedEmail() in data.members
      );
    }

    function ownsBudget(data) {
      return nonAnonymous()
        && validBudgetAccess(data)
        && data.owner == request.auth.uid;
    }

    match /budgets/{budgetId} {
      allow get: if canReadBudget(resource.data);
      allow list: if canListBudget(resource.data);
      allow create: if nonAnonymous()
        && validBudgetAccess(request.resource.data)
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.ownerEmail == verifiedEmail();
      allow update: if canReadBudget(resource.data)
        && validBudgetAccess(request.resource.data)
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && (
          ownsBudget(resource.data) ||
          request.resource.data.members == resource.data.members
        );
      allow delete: if ownsBudget(resource.data);

      match /transactions/{transactionId} {
        function parentBudget() {
          return get(/databases/$(database)/documents/budgets/$(budgetId)).data;
        }

        allow read, create, update, delete: if canReadBudget(parentBudget());
      }
    }

    match /feedback/{feedbackId} {
      allow create: if nonAnonymous();
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
