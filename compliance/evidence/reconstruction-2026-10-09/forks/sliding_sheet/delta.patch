+      headerHeight +
+      footerHeight +
+      padding.vertical +
+      borderHeight;
+  // The maxiumum height that this sheet will cover.
+  double get maxHeight => math.min(sheetHeight, availableHeight);
+  bool get isScrollable => sheetHeight >= availableHeight;
