+              alignment: AlignmentDirectional.topCenter,
+              child: ElevatedContainer(
+                shadowColor: widget.shadowColor,
+                elevation: widget.liftOnScrollHeaderElevation,
+                elevateWhen: (state) => isScrollable && !state.isAtTop,
