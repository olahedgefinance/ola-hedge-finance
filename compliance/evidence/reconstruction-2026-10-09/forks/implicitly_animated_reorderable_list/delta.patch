+    // for the insertion.
+    for (final _ActiveItem item in _incomingItems) {
+      if (item.itemIndex >= itemIndex) item.itemIndex += 1;
+    }
+    for (final _ActiveItem item in _outgoingItems) {
+      if (item.itemIndex >= itemIndex) item.itemIndex += 1;
+    }
