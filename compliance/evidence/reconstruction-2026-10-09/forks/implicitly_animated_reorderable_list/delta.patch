+  ScrollableState? _parent;
+  // A custom handler used to cancel the pending onDragStart callbacks.
+  Handler? _handler;
+  // The parent Reorderable item.
+  ReorderableState? _reorderable;
+  // The parent list.
+  ImplicitlyAnimatedReorderableListState? _list;
