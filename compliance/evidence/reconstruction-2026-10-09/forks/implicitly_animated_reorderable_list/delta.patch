+  /// An optional builder when an item was removed from the list.
+  ///
+  /// If not specified, the [ImplicitlyAnimatedList] uses the [itemBuilder] with
+  /// the animation reversed.
+  final RemovedItemBuilder<W, E>? removeItemBuilder;
